# ===========================================================================
# NorthFlux Security - Environment Variables
# ===========================================================================
# Use these names in your shell, service manager, or Compose environment.
# The application does not load .env files directly. Compose reads .env but
# forwards only the variables declared in compose.yaml. Do not commit secrets.
# ===========================================================================

# ---------------------------------------------------------------------------
# Standard Compose Configuration
# ---------------------------------------------------------------------------

# Host port published by Compose. The container always listens on port 8080.
NORTHFLUX_PORT=8080

# Log level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL).
NORTHFLUX_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Source / Service Deployment Configuration
# ---------------------------------------------------------------------------
# The standard Compose file fixes NORTHFLUX_ENV=production and uses its named
# volumes for runtime storage. The variables in this section are for direct
# source runs or a custom service definition unless compose.yaml is extended.

# Use "production" for deployed instances. Production requires DASH_TOKEN,
# disables legacy query-string authentication, and marks auth cookies Secure.
NORTHFLUX_ENV=development

# Enables the controlled legacy demo-domain workflow and reset route.
# Keep this false outside an isolated demonstration environment.
NORTHFLUX_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Dashboard Configuration (Compose and source/service deployments)
# ---------------------------------------------------------------------------

# Token for API authentication (leave empty for open access in development)
# In production, set this to a secure random string
DASH_TOKEN=

# Optional canonical browser origin used for CSRF checks behind a reverse proxy.
# Example: https://security.example.com (no trailing slash)
NORTHFLUX_PUBLIC_ORIGIN=

# Frontend serving overrides are not forwarded by the standard Compose file;
# its production image always serves the compiled application. For a direct
# source-based development run, set this after running `npm ci` and
# `npm run build` in frontend/.
NORTHFLUX_SERVE_REACT=true

# Optional path to compiled Vite output. Leave this variable unset to use
# frontend/dist; uncomment only when serving a build from another directory.
# NORTHFLUX_FRONTEND_DIST=/opt/northflux/frontend/dist

# ---------------------------------------------------------------------------
# Runtime Storage (source/custom service deployments)
# ---------------------------------------------------------------------------
# Blank values use project-local state/, reports/, and logs/. Use absolute,
# persistent, access-controlled paths in a non-Compose service deployment.
NORTHFLUX_STATE_DIR=
NORTHFLUX_REPORTS_DIR=
NORTHFLUX_LOGS_DIR=

# ---------------------------------------------------------------------------
# Cloudflare DNS Auto-Fix (Optional)
# ---------------------------------------------------------------------------
# These are only required if you want to use the --apply-fix feature
# to automatically remediate DNS misconfigurations via Cloudflare.
#
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# The token needs Zone:DNS:Edit permissions for your zone.

# Cloudflare API Token (with DNS edit permissions)
CF_API_TOKEN=

# Cloudflare Zone ID (found in your domain's Overview page)
CF_ZONE_ID=

# Cloudflare Account ID (found in your domain's Overview page sidebar)
# Required for MTA-STS Worker deployment
CF_ACCOUNT_ID=
