# ===========================================================================
# NorthFlux Security - Environment Variables
# ===========================================================================
# Use these names in your shell, service manager, or Compose environment.
# The application does not load .env files directly. Do not commit secrets.
# ===========================================================================

# ---------------------------------------------------------------------------
# General Configuration
# ---------------------------------------------------------------------------
TZ=Europe/London

# Use "production" for deployed instances. Production requires DASH_TOKEN,
# disables legacy query-string authentication, and marks auth cookies Secure.
NORTHFLUX_ENV=development

# Enables the controlled legacy demo-domain workflow and reset route.
# Keep this false outside an isolated demonstration environment.
NORTHFLUX_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Dashboard Configuration
# ---------------------------------------------------------------------------

# Token for API authentication (leave empty for open access in development)
# In production, set this to a secure random string
DASH_TOKEN=

# Optional canonical browser origin used for CSRF checks behind a reverse proxy.
# Example: https://security.example.com (no trailing slash)
NORTHFLUX_PUBLIC_ORIGIN=

# ---------------------------------------------------------------------------
# Cloudflare DNS Auto-Fix (Optional)
# ---------------------------------------------------------------------------
# These are only required if you want to use the --apply-fix feature
# to automatically remediate DNS misconfigurations via Cloudflare.
#
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# The token needs Zone:DNS:Edit permissions for your zone.

# Cloudflare API Token (with DNS edit permissions)
CF_API_TOKEN=

# Cloudflare Zone ID (found in your domain's Overview page)
CF_ZONE_ID=

# Cloudflare Account ID (found in your domain's Overview page sidebar)
# Required for MTA-STS Worker deployment
CF_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Logging Configuration
# ---------------------------------------------------------------------------

# Log level for the application (DEBUG, INFO, WARNING, ERROR, CRITICAL)
NORTHFLUX_LOG_LEVEL=INFO
